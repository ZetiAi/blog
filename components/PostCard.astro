---
/**
 * Index/listing card for a single post. Theme-agnostic: borders and text use
 * `currentColor`/opacity so the card matches the host site's palette.
 */
interface Props {
  href: string;
  title: string;
  description?: string;
  pubDate: Date;
  tags?: string[];
  readingTime?: number;
  locale?: string;
}
const { href, title, description, pubDate, tags = [], readingTime, locale = "en" } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString(locale, { year: "numeric", month: "short", day: "numeric" });
---
<a
  href={href}
  class="group block rounded-2xl border border-current/10 p-6 no-underline transition-colors hover:border-current/25"
>
  <div class="flex flex-wrap items-center gap-x-2 text-xs opacity-60">
    <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
    {readingTime && <span aria-hidden="true">·</span>}
    {readingTime && <span>{readingTime} min</span>}
  </div>
  <h2 class="mt-2 text-xl font-bold leading-snug tracking-tight transition-opacity group-hover:opacity-80">
    {title}
  </h2>
  {description && <p class="mt-2 text-sm opacity-70 line-clamp-3">{description}</p>}
  {tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="text-xs font-semibold uppercase tracking-wide opacity-60">{tag}</span>
      ))}
    </div>
  )}
</a>
